# Copy to .env and fill in. Never commit .env.
PORT=4000
NODE_ENV=development

# PostgreSQL (or set DATABASE_URL instead)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=quickcrave

# Long random string, at least 16 characters. MUST be the same in both backends.
JWT_SECRET=

# Razorpay webhook secret (Dashboard -> Developers -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# Gmail address + app password for OTP / notification emails.
# Leave empty in development: emails are printed to the console instead.
EMAIL_USER=
EMAIL_PASSWORD=

# Optional. Enables the Redis cache and the BullMQ job queue (run `npm run worker`).
# REDIS_URL=redis://localhost:6379

# Comma-separated frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:3000

# Optional tuning
# CATALOG_CACHE_TTL=300
# ORDER_RESPONSE_TIMEOUT_MS=300000
