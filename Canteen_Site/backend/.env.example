# Copy to .env and fill in. Never commit .env.
PORT=4001
NODE_ENV=development

DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASS=
DB_NAME=quickcrave

# MUST match the customer backend's JWT_SECRET
JWT_SECRET=

# Optional: same Redis as the customer backend, so menu edits clear its cache
# REDIS_URL=redis://localhost:6379

EMAIL_USER=
EMAIL_PASSWORD=

CORS_ORIGINS=http://localhost:3001
